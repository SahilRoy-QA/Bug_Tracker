{
  "entities": {
    "Defect": {
      "title": "Defect",
      "description": "A QA defect or test execution issue tracking item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique defect identifier" },
        "bugId": { "type": "string", "description": "Display Bug ID e.g. BUG-101" },
        "testCaseId": { "type": "string", "description": "Associated test case ID" },
        "title": { "type": "string", "description": "Defect summary / title" },
        "module": { "type": "string", "description": "Target module or feature area" },
        "testExecutionStatus": { "type": "string", "description": "Execution status: Passed, Failed, Blocked, Pending" },
        "defectStatus": { "type": "string", "description": "Defect lifecycle state: Open, In Progress, Resolved, Closed" },
        "severity": { "type": "string", "description": "Severity rating: Critical, High, Medium, Low" },
        "priority": { "type": "string", "description": "Priority tier: P1, P2, P3, P4" },
        "assignedTo": { "type": "string", "description": "Assigned engineer or developer" },
        "reportedBy": { "type": "string", "description": "QA engineer who reported the issue" },
        "environment": { "type": "string", "description": "Test environment and browser specifications" },
        "stepsToReproduce": { "type": "string", "description": "Reproduction steps" },
        "expectedResult": { "type": "string", "description": "Expected behavior" },
        "actualResult": { "type": "string", "description": "Actual observed outcome" },
        "driveLink": { "type": "string", "description": "Google Drive link to artifacts and screenshots" },
        "githubLink": { "type": "string", "description": "GitHub issue or PR URL" },
        "createdDate": { "type": "string", "description": "Creation date ISO string" },
        "updatedDate": { "type": "string", "description": "Last update date ISO string" }
      },
      "required": ["id", "bugId", "title", "testExecutionStatus", "defectStatus", "severity", "priority"]
    },
    "ProjectMeta": {
      "title": "ProjectMeta",
      "description": "Project configuration and QA metadata",
      "type": "object",
      "properties": {
        "projectName": { "type": "string", "description": "Name of the target project" },
        "projectLink": { "type": "string", "description": "URL to application under test" },
        "assignedQAMembers": {
          "type": "array",
          "description": "List of QA engineers assigned to project"
        },
        "estimatedStartDate": { "type": "string", "description": "Start date string" },
        "estimatedEndDate": { "type": "string", "description": "End date string" },
        "tag": { "type": "string", "description": "Project or test suite tag identifier" },
        "tags": { "type": "array", "description": "List of tags associated with the project and test suite" },
        "version": { "type": "string", "description": "Software build version" },
        "revision": { "type": "string", "description": "Build revision" }
      },
      "required": ["projectName"]
    },
    "User": {
      "title": "User",
      "description": "Authenticated QA engineer credentials and profile",
      "type": "object",
      "properties": {
        "username": { "type": "string", "description": "Unique username handle" },
        "name": { "type": "string", "description": "Display name of QA member" },
        "role": { "type": "string", "description": "Role title e.g. Lead QA Engineer" },
        "password": { "type": "string", "description": "Hashed or secured password" },
        "createdAt": { "type": "string", "description": "Account registration timestamp" },
        "updatedAt": { "type": "string", "description": "Last update timestamp" }
      },
      "required": ["username", "name", "password"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Real-time chat message exchanged between QA team members",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique message identifier" },
        "channelId": { "type": "string", "description": "Channel ID e.g. general or direct message pair" },
        "senderUsername": { "type": "string", "description": "Sender username handle" },
        "senderName": { "type": "string", "description": "Sender display name" },
        "senderRole": { "type": "string", "description": "Sender role title" },
        "content": { "type": "string", "description": "Message text content" },
        "timestamp": { "type": "string", "description": "ISO timestamp of message creation" },
        "createdAt": { "type": "number", "description": "Epoch millisecond timestamp for ordering" },
        "defectRef": { "type": "object", "description": "Optional linked defect reference" },
        "reactions": { "type": "object", "description": "Emoji reactions map" }
      },
      "required": ["channelId", "senderUsername", "senderName", "content", "timestamp"]
    }
  },
  "firestore": {
    "/defects/{defectId}": {
      "schema": "Defect",
      "description": "QA defect tracker and test execution records collection"
    },
    "/config/{configId}": {
      "schema": "ProjectMeta",
      "description": "Project settings and testing metadata collection"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and authentication credentials"
    },
    "/chat_messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Real-time team chat messages collection"
    }
  }
}
